{
  "name": "krdm-band",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply krdm-band --local",
    "db:migrate:remote": "wrangler d1 migrations apply krdm-band --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
