{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Only for D1 commands against the Previews' database, which `wrangler d1` can't
  // reach through the `previews` block in wrangler.jsonc. Keep it equal to
  // `previews.d1_databases` there.
  //   npx wrangler d1 migrations apply DB --remote -c wrangler.preview-migrations.jsonc
  "name": "krdm-band",
  "account_id": "2264e0f180a5de9805616b23d0d3b6d0",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "krdm-band-preview",
      "database_id": "d2bd0cb3-dab7-47e2-ae91-2a5868333e5c",
      "migrations_dir": "migrations"
    }
  ]
}
