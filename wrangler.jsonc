{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krdm-band",
  // The "KRDM" Cloudflare account, shared by the people who run KRDM (not anyone's
  // personal account). krdm.si's DNS moves here when band.krdm.si is needed.
  "account_id": "2264e0f180a5de9805616b23d0d3b6d0",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The PWA is served as static assets; the Worker only runs for the API and the
  // product photos. Every other path falls back to index.html (client routing).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Created with `wrangler d1 create krdm-band --location weur` (2026-11-23) and filled
      // with an export of the first database (`krdm-merch`, in a personal account).
      "database_name": "krdm-band",
      "database_id": "5b04d7ed-adbc-4bb3-8a16-79fc4d1137cc",
      "migrations_dir": "migrations"
    }
  ],
  // KRDM's shared media bucket: the website's CMS uploads to it too, so this app
  // keeps to its own prefixes (`products/`, `imported/`) and never deletes outside them.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "krdm-media" }],
  // Secrets (wrangler secret put): IP_SALT — hashes customer IPs for the order rate limit.

  // Production at https://krdm-band.krdm.workers.dev; Previews (see below) at
  // https://<name>-krdm-band.krdm.workers.dev.
  "workers_dev": true,
  "preview_urls": true,
  // Workers Previews (`wrangler preview --name <branch>`, run by
  // .github/workflows/deploy.yml): every branch, and `main` itself as the permanent
  // https://main-krdm-band.krdm.workers.dev, runs on its own database and bucket so
  // nothing done there touches real stock, orders or photos. All Previews share them.
  // Previews inherit no bindings, so every binding above needs its pair here.
  // Secrets: `wrangler preview base-config secret put IP_SALT` (new Previews copy it).
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        // Created 2026-11-23 (weur). Migrated through wrangler.preview-migrations.jsonc.
        "database_name": "krdm-band-preview",
        "database_id": "d2bd0cb3-dab7-47e2-ae91-2a5868333e5c"
      }
    ],
    "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "krdm-band-preview" }]
  }
}
