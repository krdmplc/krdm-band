{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krdm-merch",
  // "Martin Jagodic Personal". DNS for krdm.si moves here when merch.krdm.si is needed.
  "account_id": "eb91c59227870b58663b4f9346affa87",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The PWA is served as static assets; the Worker only runs for the API and the
  // product photos. Every other path falls back to index.html (client routing).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "krdm-merch",
      // Created with `wrangler d1 create krdm-merch --location weur` (2026-11-23).
      "database_id": "095aa713-0010-451a-8c8d-bf7340351eb4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "krdm-merch-images" }]
  // Secrets (wrangler secret put): IP_SALT — hashes customer IPs for the order rate limit.
}
